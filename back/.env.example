NODE_ENV=development
PORT=3000
# Postgres do docker-compose deste projeto (porta 5440)
DATABASE_URL=postgres://mundo:mundo@localhost:5440/mundo_iphones
DB_POOL_MAX=10
# mínimo de 32 caracteres; gere com: openssl rand -hex 32
JWT_SECRET=
# token de acesso curto; a sessão se mantém pelo refresh token
JWT_EXPIRES_IN=15m
REFRESH_TTL_DIAS=7
# origens do front permitidas, separadas por vírgula
CORS_ORIGIN=http://127.0.0.1:5175,http://localhost:5175
